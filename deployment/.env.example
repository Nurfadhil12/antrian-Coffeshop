# deployment/.env.example
# Salin:  cp deployment/.env.example deployment/.env
# File .env JANGAN di-commit (sudah masuk deployment/.gitignore).
# Semua nilai di sini di-interpolasi oleh docker compose (lihat docker-compose.yml).

# ── Identitas project & domain ────────────────────────────────
COMPOSE_PROJECT_NAME=coffeeshop
# Domain publik tanpa protokol. Untuk coba-coba lokal: localhost
DOMAIN=localhost
# Email untuk notifikasi Let's Encrypt (wajib kalau DOMAIN bukan domain lokal)
LETSENCRYPT_EMAIL=admin@example.com
# 1 = pakai staging Let's Encrypt (sertifikat tidak dipercaya browser, tapi
# tidak kena rate limit) — pakai ini untuk uji coba dulu, lalu ubah ke 0.
LETSENCRYPT_STAGING=1
TZ=Asia/Jakarta

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_VERSION=17
POSTGRES_USER=postgres
# WAJIB diganti. Kalau mengandung karakter spesial (@ : / # ?), URL-encode dulu
# karena nilai ini dipakai juga di DATABASE_URL.
POSTGRES_PASSWORD=ubah-password-ini-jadi-panjang-dan-acak
POSTGRES_DB=coffeeshop
# Port di host HANYA untuk pengembangan (bind ke 127.0.0.1). Ubah kalau 55432
# sudah dipakai — di produksi port ini ditutup oleh docker-compose.prod.yml.
POSTGRES_PORT=55432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_LOG_MIN_DURATION_MS=1000

# ── Backend (NestJS) ──────────────────────────────────────────
NODE_VERSION=24
# Migrasi TIDAK dijalankan oleh proses API (image runtime memang tidak membawa
# Prisma CLI). Migrasi dijalankan service "api-migrate" yang wajib selesai sukses
# sebelum api start, dan bisa dipicu manual dengan: make migrate
RUN_MIGRATIONS=false
LOG_LEVEL=info
# Zona waktu toko: menentukan "hari ini" untuk nomor antrian & tutup buku
SHOP_TIMEZONE=Asia/Jakarta
# Origin yang diizinkan CORS, dipisah koma. Kosong = izinkan semua (mode lokal).
# Di produksi semua lewat domain yang sama, jadi boleh dikosongkan.
CORS_ORIGIN=
# Batas koneksi pool PostgreSQL per container api (jangan melebihi POSTGRES_MAX_CONNECTIONS)
DB_POOL_MAX=10
API_IMAGE=coffeeshop-api:local
API_MIGRATE_IMAGE=coffeeshop-api:migrator

# ── Frontend (Next.js) ────────────────────────────────────────
# Ditanam saat BUILD (NEXT_PUBLIC_*), bukan runtime. Semua trafik lewat domain yang
# sama, jadi relatif "/api" paling aman.
NEXT_PUBLIC_API_URL=/api
WEB_IMAGE=coffeeshop-web:local
# Akses langsung ke frontend tanpa Nginx/TLS: http://localhost:3120
# (hanya 127.0.0.1 — tidak terbuka ke internet).
WEB_PORT=3120

# ── Nginx / TLS ───────────────────────────────────────────────
NGINX_VERSION=stable
NGINX_IMAGE=coffeeshop-nginx:local
CERTBOT_VERSION=v5.8.0
# Default 8080/8443 supaya tidak bentrok dengan stack lain di mesin yang sama.
# Di VPS sendiri, ubah ke 80/443 (Let's Encrypt butuh port 80 dari internet).
HTTP_PORT=8080
HTTPS_PORT=8443
NGINX_CLIENT_MAX_BODY_SIZE=25m

# ── Backup ────────────────────────────────────────────────────
# Path relatif terhadap folder deployment/
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# ── Limit resource (dipakai docker-compose.prod.yml) ──────────
DB_CPU_LIMIT=1.0
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=512m
API_CPU_LIMIT=1.5
API_MEM_LIMIT=1g
API_MEM_RESERVATION=256m
WEB_CPU_LIMIT=1.0
WEB_MEM_LIMIT=768m
WEB_MEM_RESERVATION=256m
NGINX_CPU_LIMIT=1.0
NGINX_MEM_LIMIT=256m
